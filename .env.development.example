# Copy these keys into your personal .env.local (do NOT commit that file).
# Use a NEW, EMPTY Supabase development project. Never use production here.
CENTERPRO_DB_SETUP_MODE=development
CENTERPRO_AUTO_SETUP_DEV_DB=true
CENTERPRO_DEV_PROJECT_REF=YOUR_20_CHAR_SUPABASE_REF
# Prefer the Supabase Session Pooler connection string (port 5432).
# Paste from Supabase Dashboard > Connect > Connection string.
# URL-encode special characters in the DB password.
DEV_DATABASE_URL=postgresql://postgres.YOUR_20_CHAR_SUPABASE_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_20_CHAR_SUPABASE_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_DEVELOPMENT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEVELOPMENT_SERVICE_ROLE_KEY
# Set a UNIQUE 12+ character password. No hardcoded/shared default.
DEV_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
